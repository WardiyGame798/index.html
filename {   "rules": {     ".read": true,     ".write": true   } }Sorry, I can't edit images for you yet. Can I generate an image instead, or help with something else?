<script type="module">
  // ===== CẤU HÌNH FIREBASE =====
  import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
  import { getDatabase, ref, set, get, onValue, off, update, remove } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-database.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBKPmfYO2G17iEfx2V3Kh9fwDKPvwsB-iY",
    authDomain: "keobuabao-db4b0.firebaseapp.com",
    projectId: "keobuabao-db4b0",
    storageBucket: "keobuabao-db4b0.firebasestorage.app",
    messagingSenderId: "321649025626",
    appId: "1:321649025626:web:2187c8c75f58a7b69c8c77"
  };

  const app = initializeApp(firebaseConfig);
  const db = getDatabase(app);

  // ===== BIẾN TOÀN CỤC =====
  let playerName = "";
  let playerAvatar = "🦖";
  let currentRoomCode = null;
  let isHost = false;
  let playerId = null;
  let gameMode = null;
  let maxPlayersInRoom = 2;
  let aiOpponentCount = 1;
  let gameState = { players: {}, round: 0, status: 'waiting' };
  let firebaseListener = null;
  let scoreP1 = 0, scoreP2 = 0;
  let gameEnded = false;

  // Cài đặt hỗ trợ tiếp cận
  let accessSettings = { 
    announceResult: false, 
    announceTaunt: false, 
    soundEnabled: true,
    musicEnabled: false
  };

  // ===== HỆ THỐNG ÂM THANH =====
  const AudioContext = window.AudioContext || window.webkitAudioContext;
  let audioCtx = null;

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new AudioContext();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playSound(type) {
    if (!accessSettings.soundEnabled || !audioCtx) return;
    
    const oscillator = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    oscillator.connect(gainNode);
    gainNode.connect(audioCtx.destination);

    switch(type) {
      case 'click':
        oscillator.frequency.value = 600;
        oscillator.type = 'sine';
        gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        oscillator.start(audioCtx.currentTime);
        oscillator.stop(audioCtx.currentTime + 0.1);
        break;
      case 'win':
        oscillator.frequency.value = 523.25;
        oscillator.type = 'sine';
        gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);
        oscillator.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
        oscillator.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.2);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
        oscillator.start(audioCtx.currentTime);
        oscillator.stop(audioCtx.currentTime + 0.4);
        break;
      case 'lose':
        oscillator.frequency.value = 300;
        oscillator.type = 'sawtooth';
        gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.3);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
        oscillator.start(audioCtx.currentTime);
        oscillator.stop(audioCtx.currentTime + 0.3);
        break;
      case 'tie':
        oscillator.frequency.value = 400;
        oscillator.type = 'triangle';
        gainNode.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);
        oscillator.start(audioCtx.currentTime);
        oscillator.stop(audioCtx.currentTime + 0.15);
        break;
      case 'complete':
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.frequency.value = freq;
          osc.type = 'sine';
          gain.gain.setValueAtTime(0.15, audioCtx.currentTime + i * 0.12);
          gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + i * 0.12 + 0.2);
          osc.start(audioCtx.currentTime + i * 0.12);
          osc.stop(audioCtx.currentTime + i * 0.12 + 0.2);
        });
        break;
    }
  }

  // ===== DANH SÁCH TÊN MÁY & LỜI NÓI =====
  const aiNames = [
    "Búa Bao Vương 👑", "Kéo Siêu Văng ✂️", "Bao Bao Đường 🖐️", 
    "Đầu To Chơi Dở 🤕", "Chân Ngắn Chạy Chậm 🦵", "Thua Không Khóc 😭", 
    "Đấu Sĩ Mới Nhập Môn 🐣", "Thần Sầu Cấp 3 🤡", "Bốc Bừa Bốc Ngẫu 🎲",
    "Mày Đâu Thắng Được Tao 😎", "Tao Chơi Bằng Cảm Xúc 💖", "Kéo Luôn Thắng ✌️",
    "Búa Này Không Có Nhọn 🪨", "Tới Mày Rồi Nè 😉", "Đừng Khóc Nha Thua Cũng Bình Thường 😂",
    "Tao Đoán Mày Sẽ Búa 🤔", "Mày Đang Sợ Rồi Phải Không 😏", "Để Tao Dạy Mày Chơi 👨‍🏫",
    "Thua Nhiều Sẽ Thành Thạo 💪", "Tao Đi Trước Nha 🚶‍♂️", "Chơi Cho Vui Thôi Mà Bạn 🌸",
    "Tao Có Kẹo Đây Nè 🍬", "Đừng Nhìn Nhau Mà Chơi Đi 😉"
  ];

  const tauntsWin = [
    "Hahaha, mày ăn hành nha! 😂", "Đi về tập lại nha em 👋", 
    "Cỡ này thì tao chơi mười người một lúc cũng được 😎", "Mày chưa đủ trình đâu nha 😉",
    "Ối giời ơi, yếu quá vậy má 😆", "Thua không khóc nha, có kẹo đây 😜",
    "Tao đã nói mày không thắng được tao mà, không nghe! 🤷‍♂️",
    "Đầu hàng đi, không có cửa đâu nha bạn 😏", "Nâng cấp trình trước rồi đấu tiếp nha! 📚"
  ];

  const tauntsLose = [
    "Ối, mày lừa tao à! 😤", "Đừng Mừng Quá Sớm Nha! Lần Sau Tao Rửa Hận! 😠",
    "May Thôi! Đúng Là May Rủi! 🎲", "Ừ được đó, có chút tiến bộ 😉",
    "Đừng Kiêu, Lần Sau Mày Xem! 😒", "Ối chao, tao lỡ tay rồi 😭",
    "Được mấy ván thôi, đừng nghĩ mình giỏi nha 😏", "Chờ đó, tao trả thù liền! 🏃‍♂️"
  ];

  const tauntsTie = [
    "Ồ, cùng suy nghĩ à? Tình yêu à? 😏", "Kẹt này kìa, ai cũng không tiến bộ được 😂",
    "Đồng thanh đồng khí, hay là mình có duyên? 😜", "Hai đứa bằng nhau, xỉu ai đây? 🤔",
    "Song kiếm hợp bích à? Cùng chọn luôn à 😆"
  ];

  // ===== HÀM HỖ TRỢ =====
  function getRandomItem(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function getRandomAIName() { return getRandomItem(aiNames); }

  function speak(text) {
    if (!accessSettings.announceResult || !text) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'vi-VN';
    utterance.volume = 1;
    utterance.rate = 1.1;
    utterance.pitch = 1;
    window.speechSynthesis.speak(utterance);
  }

  function showScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
    closeMenuPanel();
  }

  function closeMenuPanel() {
    document.getElementById('menuPanel').classList.remove('open');
    document.getElementById('menuPanel').setAttribute('aria-hidden', 'true');
  }

  function generateRoomCode() {
    return Math.floor(100000 + Math.random() * 900000).toString();
  }

  function determineWinner(choice1, choice2) {
    if (choice1 === choice2) return 'tie';
    if (
      (choice1 === 'rock' && choice2 === 'scissors') ||
      (choice1 === 'scissors' && choice2 === 'paper') ||
      (choice1 === 'paper' && choice2 === 'rock')
    ) return 'p1';
    return 'p2';
  }

  function updateScoreBoard() {
    document.getElementById('playerScore').textContent = scoreP1;
    document.getElementById('opponentScore').textContent = scoreP2;
  }

  function setStatus(msg, announceText = '') {
    document.getElementById('statusMsg').textContent = msg;
    if (announceText && accessSettings.announceResult) {
      speak(announceText);
    }
  }

  // ===== XỬ LÝ MENU =====
  const menuPanel = document.getElementById('menuPanel');
  const menuToggle = document.getElementById('menuToggle');
  const closeMenuBtn = document.getElementById('closeMenu');

  menuToggle.addEventListener('click', () => {
    initAudio();
    const isOpen = menuPanel.classList.contains('open');
    if (isOpen) {
      closeMenuPanel();
    } else {
      menuPanel.classList.add('open');
      menuPanel.setAttribute('aria-hidden', 'false');
    }
  });

  closeMenuBtn.addEventListener('click', closeMenuPanel);

  // Cập nhật cài đặt khi người dùng thay đổi
  document.getElementById('announceResult').addEventListener('change', e => {
    accessSettings.announceResult = e.target.checked;
    if (e.target.checked) {
      speak("Đã bật đọc thông báo");
    }
  });

  document.getElementById('announceTaunt').addEventListener('change', e => {
    accessSettings.announceTaunt = e.target.checked;
  });

  document.getElementById('enableSound').addEventListener('change', e => {
    accessSettings.soundEnabled = e.target.checked;
    if (e.target.checked) {
      initAudio();
      playSound('click');
    }
  });

  document.getElementById('enableMusic').addEventListener('change', e => {
    accessSettings.musicEnabled = e.target.checked;
  });

  // ===== CHỌN AVATAR =====
  document.querySelectorAll('.avatar-option').forEach(el => {
    el.addEventListener('click', () => {
      initAudio();
      playSound('click');
      document.querySelectorAll('.avatar-option').forEach(a => a.classList.remove('selected'));
      el.classList.add('selected');
      playerAvatar = el.dataset.avatar;
    });
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.click();
      }
    });
  });

  // ===== NÚT ĐIỀU HƯỚNG =====
  document.getElementById('btnStart').addEventListener('click', () => {
    initAudio();
    playSound('click');
    playerName = document.getElementById('playerName').value.trim() || "Người chơi mới";
    playerId = 'player-' + Math.random().toString(36).substr(2, 9);
    showScreen('screen-mode');
  });

  document.getElementById('btnBackWelcome').addEventListener('click', () => { playSound('click'); showScreen('screen-welcome'); });
  document.getElementById('btnBackMode').addEventListener('click', () => { playSound('click'); showScreen('screen-mode'); });
  document.getElementById('btnBackMode2').addEventListener('click', () => { playSound('click'); showScreen('screen-mode'); });
  document.getElementById('btnBackAISelect').addEventListener('click', () => { playSound('click'); showScreen('screen-ai-select'); });
  document.getElementById('btnBackRoom').addEventListener('click', () => { playSound('click'); showScreen('screen-room'); });

  document.getElementById('btnVsAI').addEventListener('click', () => { playSound('click'); showScreen('screen-ai-select'); });
  document.getElementById('btnVsFriends').addEventListener('click', () => { playSound('click'); showScreen('screen-room'); });

  // Chơi với AI — chọn kiểu
  document.getElementById('btnSingleVsAI').addEventListener('click', () => {
    playSound('click');
    gameMode = 'ai-single';
    startSingleVsAI();
  });

  document.getElementById('btnMultiVsAI').addEventListener('click', () => {
    playSound('click');
    gameMode = 'ai-multi';
    showScreen('screen-ai-count');
  });

  // Cập nhật hiển thị số lượng máy
  const aiCountSlider = document.getElementById('aiCountSlider');
  aiCountSlider.addEventListener('input', e => {
    aiOpponentCount = parseInt(e.target.value);
    document.getElementById('aiCountDisplay').textContent = aiOpponentCount;
    document.getElementById('totalPlayersDisplay').textContent = aiOpponentCount + 1;
  });
  aiCountSlider.dispatchEvent(new Event('input'));

  document.getElementById('btnStartAI').addEventListener('click', () => {
    playSound('click');
    startMultiVsAI(aiOpponentCount);
  });

  // Tạo/tham gia phòng bạn bè
  const maxPlayersSlider = document.getElementById('maxPlayersSlider');
  maxPlayersSlider.addEventListener('input', e => {
    maxPlayersInRoom = parseInt(e.target.value);
    document.getElementById('maxPlayersNumber').textContent = maxPlayersInRoom;
  });
  maxPlayersSlider.dispatchEvent(new Event('input'));

  document.getElementById('btnCreateRoom').addEventListener('click', () => {
    playSound('click');
    showScreen('screen-create-room');
  });

  document.getElementById('btnConfirmCreate').addEventListener('click', async () => {
    playSound('click');
    currentRoomCode = generateRoomCode();
    isHost = true;
    await createRoomInDB(currentRoomCode, maxPlayersInRoom);
    enterGameScreen();
  });

  document.getElementById('btnJoinRoom').addEventListener('click', async () => {
    playSound('click');
    const code = document.getElementById('roomCodeInput').value.trim();
    if (!code) { alert('Nhập mã phòng nha bạn!'); return; }
    currentRoomCode = code;
    isHost = false;
    const ok = await joinRoomInDB(code);
    if (!ok) { alert('Không tìm thấy phòng hoặc phòng đã đầy!'); return; }
    enterGameScreen();
  });

  // Nút chọn kéo/búa/bao
  document.querySelectorAll('.choice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (gameEnded) return;
      initAudio();
      playSound('click');
      const choice = btn.dataset.choice;
      handlePlayerChoice(choice);
    });
  });

  document.getElementById('btnPlayAgain').addEventListener('click', () => {
    playSound('click');
    if (gameMode === 'ai-single') {
      resetSingleAIGame();
    } else if (gameMode === 'ai-multi') {
      resetMultiAIGame();
    } else {
      resetRoomGame();
    }
  });

  document.getElementById('btnLeaveRoom').addEventListener('click', () => {
    playSound('click');
    if (confirm('Bạn có chắc muốn rời phòng không?')) {
      leaveRoom();
      showScreen('screen-welcome');
    }
  });

  // ===== LOGIC GAME =====
  function enterGameScreen() {
    showScreen('screen-game');
    gameEnded = false;
    document.getElementById('gameEndActions').classList.add('hidden');
    document.getElementById('roomCodeDisplay').textContent = currentRoomCode ? `Mã phòng: ${currentRoomCode}` : 'Chơi với máy';
    scoreP1 = scoreP2 = 0;
    updateScoreBoard();
    attachFirebaseListener();
  }

  // --- Chơi với máy 1v1 ---
  function startSingleVsAI() {
    gameMode = 'ai-single';
    currentRoomCode = null;
    enterGameScreen();
    document.getElementById('roomCodeDisplay').textContent = 'Chơi 1 vs Máy — Điểm đến 10';
    document.getElementById('scoreBoard').style.display = 'block';
    document.getElementById('gameControls').classList.remove('hidden');
    document.getElementById('playerListContainer').style.display = 'none';
    setStatus('Bắt đầu thôi! Chọn kéo/búa/bao đi!', 'Bắt đầu chơi! Chọn kéo búa bao đi!');
  }

  function resetSingleAIGame() {
    gameEnded = false;
    scoreP1 = scoreP2 = 0;
    updateScoreBoard();
    document.getElementById('gameEndActions').classList.add('hidden');
    document.getElementById('gameControls').classList.remove('hidden');
    setStatus('Bắt đầu lại! Chọn kéo/búa/bao!', 'Bắt đầu lại!');
  }

  // --- Chơi nhiều người với máy ---
  function startMultiVsAI(count) {
    gameMode = 'ai-multi';
    currentRoomCode = null;
    enterGameScreen();
    document.getElementById('roomCodeDisplay').textContent = `Chơi với ${count} máy — Loại bỏ dần`;
    document.getElementById('scoreBoard').style.display = 'none';
    document.getElementById('gameControls').classList.remove('hidden');
    document.getElementById('playerListContainer').style.display = 'block';
    
    gameState.players = {};
    gameState.players[playerId] = { name: playerName, avatar: playerAvatar, eliminated: false, isAI: false };
    for (let i = 0; i < count; i++) {
      const aiId = 'ai-' + i;
      gameState.players[aiId] = { 
        name: getRandomAIName(), 
        avatar: ['🤖', '👾', '🎮', '🕹️', '🎯'][i % 5], 
        eliminated: false, 
        isAI: true 
      };
    }
    renderPlayerList();
    setStatus(`Có ${count + 1} người chơi! Bắt đầu chọn lượt đi!`, `Có ${count + 1} người chơi! Bắt đầu thôi!`);
  }

  function resetMultiAIGame() {
    gameEnded = false;
    document.getElementById('gameEndActions').classList.add('hidden');
    startMultiVsAI(aiOpponentCount);
  }

  function renderPlayerList() {
    const list = document.getElementById('playerList');
    list.innerHTML = '';
    Object.entries(gameState.players || {}).forEach(([id, p]) => {
      const div = document.createElement('div');
      div.className = 'player-item' + (p.eliminated ? ' eliminated' : '');
      div.textContent = `${p.avatar} ${p.name}${p.eliminated ? ' — Đã bị loại' : ''}`;
      list.appendChild(div);
    });
  }

  function handlePlayerChoice(playerChoice) {
    if (gameEnded) return;
    document.getElementById('gameControls').classList.add('hidden');

    if (gameMode === 'ai-single') {
      const aiChoice = ['rock', 'paper', 'scissors'][Math.floor(Math.random() * 3)];
      const result = determineWinner(playerChoice, aiChoice);
      
      const choiceEmoji = { rock: '✊', paper: '🖐️', scissors: '✌️' };
      let resultText = `Bạn chọn ${choiceEmoji[playerChoice]} — Máy chọn ${choiceEmoji[aiChoice]}\n`;
      let speechText = '';
      
      if (result === 'tie') {
        playSound('tie');
        const taunt = getRandomItem(tauntsTie);
        resultText += taunt;
        speechText = 'Hòa! ' + (accessSettings.announceTaunt ? taunt : '');
      } else if (result === 'p1') {
        playSound('win');
        scoreP1++;
        resultText += `Bạn thắng ván này! 🎉`;
        speechText = `Bạn thắng! Điểm số: ${scoreP1} đến ${scoreP2}`;
      } else {
        playSound('lose');
        const taunt = getRandomItem(tauntsWin);
        resultText += `Máy thắng! ${taunt}`;
        scoreP2++;
        speechText = `Máy thắng! Điểm số: ${scoreP1} đến ${scoreP2}`;
        if (accessSettings.announceTaunt && accessSettings.announceResult) {
          speechText += '. ' + taunt;
        }
      }
      
      updateScoreBoard();
      setStatus(resultText, speechText);
      
      // Kiểm tra kết thúc game
      if (scoreP1 >= 10 || scoreP2 >= 10) {
        gameEnded = true;
        playSound('complete');
        const win = scoreP1 >= 10;
        const finalMsg = win 
          ? `🏆 CHÚC MỪNG! BẠN THẮNG TOÀN TRẬN! Kết quả: ${scoreP1} — ${scoreP2} 🏆` 
          : `😔 Máy thắng chung cuộc rồi! Kết quả: ${scoreP1} — ${scoreP2}. Cố gắng lần sau nha!`;
        setStatus(finalMsg, win ? 'Chúc mừng bạn đã thắng toàn trận!' : 'Máy thắng toàn trận rồi! Cố gắng lên!');
        document.getElementById('gameEndActions').classList.remove('hidden');
      } else {
        // Tiếp tục vòng sau
        setTimeout(() => {
          document.getElementById('gameControls').classList.remove('hidden');
          setStatus('Tiếp theo! Chọn đi!', 'Tiếp theo!');
        }, 1500);
      }
    }
    else if (gameMode === 'ai-multi') {
      // Nhiều người vs máy: loại bỏ dần
      const allChoices = { [playerId]: playerChoice };
      Object.entries(gameState.players || {}).forEach(([id, p]) => {
        if (p.isAI && !p.eliminated) {
          allChoices[id] = ['rock', 'paper', 'scissors'][Math.floor(Math.random() * 3)];
        }
      });

      // Tìm lựa chọn bị loại
      const counts = { rock: 0, paper: 0, scissors: 0 };
      Object.values(allChoices).forEach(c => counts[c]++);
      const minCount = Math.min(...Object.values(counts));
      const losingChoice = Object.keys(counts).find(k => counts[k] === minCount);

      let eliminatedNames = [];
      Object.entries(gameState.players || {}).forEach(([id, p]) => {
        if (!p.eliminated && allChoices[id] === losingChoice) {
          p.eliminated = true;
          eliminatedNames.push(p.name);
        }
      });

      renderPlayerList();
      const remaining = Object.values(gameState.players || {}).filter(p => !p.eliminated);
      
      if (remaining.length === 1) {
        gameEnded = true;
        playSound('complete');
        const winMsg = `🏆 ${remaining[0].name} THẮNG TOÀN TRẬN! 🏆`;
        setStatus(winMsg, winMsg);
        document.getElementById('gameEndActions').classList.remove('hidden');
      } else {
        eliminatedNames.length > 0 ? playSound('lose') : playSound('tie');
        const msg = eliminatedNames.length 
          ? `${eliminatedNames.join(', ')} bị loại! Còn lại ${remaining.length} người! Tiếp tục!` 
          : 'Không ai bị loại! Tiếp tục đấu!';
        setStatus(msg, msg);
        setTimeout(() => document.getElementById('gameControls').classList.remove('hidden'), 1500);
      }
    }
    else {
      // Chơi với bạn bè qua Firebase
      update(ref(db, `rooms/${currentRoomCode}/players/${playerId}`), { choice: playerChoice });
    }
  }

  // ===== FIREBASE PHẦN =====
  async function createRoomInDB(code, maxP) {
    await set(ref(db, `rooms/${code}`), {
      maxPlayers: maxP,
      status: 'waiting',
      createdAt: Date.now()
    });
    await update(ref(db, `rooms/${code}/players/${playerId}`), {
      name: playerName, avatar: playerAvatar, isHost: true, choice: null, eliminated: false
    });
  }

  async function joinRoomInDB(code) {
    const snap = await get(ref(db, `rooms/${code}`));
    if (!snap.exists()) return false;
    const room = snap.val();
    const playerCount = room.players ? Object.keys(room.players).length : 0;
    if (playerCount >= room.maxPlayers) return false;
    
    await update(ref(db, `rooms/${code}/players/${playerId}`), {
      name: playerName, avatar: playerAvatar, isHost: false, choice: null, eliminated: false
    });
    maxPlayersInRoom = room.maxPlayers;
    gameMode = maxPlayersInRoom === 2 ? 'friend-2p' : 'friend-multi';
    return true;
  }

  function attachFirebaseListener() {
    if (!currentRoomCode) return;
    detachFirebaseListener();
    firebaseListener = onValue(ref(db, `rooms/${currentRoomCode}`), snap => {
      if (!snap.exists()) return;
      const room = snap.val();
      gameState.players = room.players || {};
      renderPlayerList();
      
      const numPlayers = Object.keys(gameState.players).length;
      if (numPlayers < maxPlayersInRoom) {
        setStatus(`Đang chờ người khác tham gia... ${numPlayers}/${maxPlayersInRoom}`, 'Đang chờ người khác tham gia');
        document.getElementById('gameControls').classList.add('hidden');
      } else {
        const allHaveChoices = Object.values(gameState.players).every(p => p.choice);
        if (allHaveChoices) {
          processRoundResult();
        } else {
          setStatus('Đủ người rồi! Chọn lượt đi của bạn!', 'Đủ người rồi! Chọn đi!');
          document.getElementById('gameControls').classList.remove('hidden');
        }
      }
    });
  }

  function detachFirebaseListener() {
    if (firebaseListener) {
      off(ref(db, `rooms/${currentRoomCode}`));
      firebaseListener = null;
    }
  }

  function processRoundResult() {
    // Xử lý kết quả vòng đấu cho phòng bạn bè
    const choices = Object.entries(gameState.players).map(([id, p]) => `${p.name}: ${p.choice}`).join(', ');
    setStatus(`Đã chọn: ${choices} — Kết quả đang xử lý...`, 'Kết quả vòng đấu!');
    
    // Reset lựa chọn cho vòng sau
    setTimeout(() => {
      Object.keys(gameState.players).forEach(pid => {
        update(ref(db, `rooms/${currentRoomCode}/players/${pid}`), { choice: null });
      });
    }, 2000);
  }

  function resetRoomGame() {
    if (!currentRoomCode) return;
    setStatus('Bắt đầu vòng mới!', 'Bắt đầu vòng mới!');
    document.getElementById('gameEndActions').classList.add('hidden');
  }

  function leaveRoom() {
    if (!currentRoomCode) return;
    detachFirebaseListener();
    remove(ref(db, `rooms/${currentRoomCode}/players/${playerId}`));
    // Nếu là chủ phòng và không còn ai, xóa phòng
    get(ref(db, `rooms/${currentRoomCode}/players`)).then(snap => {
      if (!snap.exists() || Object.keys(snap.val() || {}).length === 0) {
        remove(ref(db, `rooms/${currentRoomCode}`));
      }
    });
    currentRoomCode = null;
  }

  // ===== KHỞI TẠO =====
  document.getElementById('playerName').value = '';
  document.querySelector('.avatar-option').classList.add('selected');
</script>

</body>
</html>
